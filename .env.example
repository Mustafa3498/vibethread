# ── App ──
NODE_ENV=development
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ── Postgres (matches docker-compose.yml) ──
POSTGRES_USER=vibethread
POSTGRES_PASSWORD=vibethread_dev_pw
POSTGRES_DB=vibethread
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vibethread:vibethread_dev_pw@localhost:5432/vibethread?schema=public

# ── Redis ──
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Auth (used from Step 3) ──
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
