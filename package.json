{
  "name": "vibethread",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "npm@10.8.2",
  "engines": { "node": ">=20" },
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run generate -w @vibethread/database",
    "db:migrate": "npm run migrate:dev -w @vibethread/database",
    "db:deploy": "npm run migrate:deploy -w @vibethread/database",
    "db:seed": "npm run seed -w @vibethread/database",
    "db:studio": "npm run studio -w @vibethread/database"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}
